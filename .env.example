# Chatterbox configuration (all optional — sensible defaults built in)

# Port the server listens on
PORT=5340

# Admin panel password (username is not used, password only)
ADMIN_PASSWORD=admin

# Where the SQLite database lives (defaults to ./data)
# DATA_DIR=/data

# Public origin of this install, used in the embed snippet + reply-notification links
BASE_URL=http://localhost:5340

# BYO-SMTP for reply notifications (off by default — configure in Settings, or here)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
